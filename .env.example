# ============================================================
# Variables de entorno del backend (Render > Service > Environment)
# Copia este archivo como referencia; NO subas valores reales a Git.
# ============================================================

# ---------- Base de datos: PostgreSQL ----------
# 1) La forma recomendada para Render es usar JDBC_DATABASE_URL, porque el valor de
#    DATABASE_URL puede venir en formato postgres://... (no JDBC).
#    Si usas Supabase, normalmente la cadena ya es jdbc:postgresql://... con ?sslmode=require.
# Ejemplo para Render:
JDBC_DATABASE_URL=jdbc:postgresql://dpg-xxxxx-a.oregon-postgres.render.com:5432/plh_backend?sslmode=require
# También puedes dejar DATABASE_URL como respaldo si tu hosting ya lo entrega en formato JDBC.
DATABASE_URL=jdbc:postgresql://aws-0-XX.pooler.supabase.com:5432/postgres?sslmode=require
# Usuario: normalmente "postgres" (o el rol que crees en Supabase/Render).
DATABASE_USERNAME=postgres
# El PASSWORD de la base de datos.
DATABASE_PASSWORD=tu_password_de_base_de_datos

# ---------- Seguridad JWT ----------
# Genera uno largo, p.ej.: openssl rand -base64 64
JWT_SECRET=cambia_este_secret_largo_y_aleatorio
JWT_EXPIRATION_MS=86400000

# ---------- CORS ----------
# URL del frontend ya desplegado (sin barra final), varias separadas por coma.
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,http://localhost:4200

# ---------- Opcionales ----------
# JPA_DDL_AUTO=update        # default: update (solo agrega tablas/columnas)
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=0
# DB_MAX_LIFETIME_MS=240000
# DB_KEEPALIVE_MS=120000
# JAVA_OPTS=-XX:MaxRAMPercentage=70.0

# ---------- Supabase API / Auth (guardadas por si se integran después) ----------
# El backend hoy NO usa estas claves: emite sus propios JWT con JWT_SECRET.
# Si más adelante se valida el auth de Supabase, se usarán para JWKS.
SUPABASE_URL=https://buvroktgplslyldupnct.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://buvroktgplslyldupnct.supabase.co/auth/v1/.well-known/jwks.json
